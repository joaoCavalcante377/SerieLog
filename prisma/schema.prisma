generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum LogStatus {
  WATCHING
  COMPLETED
  DROPPED
}

// ───────────── Auth ─────────────

model User {
  id             String    @id @default(cuid())
  name           String
  username       String?   @unique // stored lowercase; null until chosen (Google sign-up)
  email          String    @unique
  emailVerified  DateTime?
  passwordHash   String?
  image          String?
  bio            String?
  watchlistPublic Boolean  @default(true)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  accounts        Account[]
  sessions        Session[]
  logs            SeriesLog[]
  episodeWatches  EpisodeWatch[]
  seasonRatings   SeasonRating[]
  watchlist       WatchlistItem[]
  lists           SeriesList[]
  favorites       FavoriteSeries[]
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@unique([identifier, token])
}

// ───────────── TMDB cache ─────────────

model Series {
  id               String    @id @default(cuid())
  tmdbId           Int       @unique
  name             String
  originalName     String
  overview         String?
  overviewIsFallback Boolean @default(false) // true when overview is the en-US fallback
  firstAirDate     DateTime? @db.Date
  lastAirDate      DateTime? @db.Date
  status           String
  posterPath       String?
  backdropPath     String?
  numberOfSeasons  Int       @default(0)
  numberOfEpisodes Int       @default(0)
  episodeRunTime   Int?
  lastSyncedAt     DateTime
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  genres         SeriesGenre[]
  seasons        Season[]
  episodes       Episode[]
  logs           SeriesLog[]
  episodeWatches EpisodeWatch[]
  watchlistItems WatchlistItem[]
  listItems      SeriesListItem[]
  favorites      FavoriteSeries[]

  @@index([firstAirDate])
}

model Season {
  id           String    @id @default(cuid())
  seriesId     String
  tmdbSeasonId Int
  seasonNumber Int
  name         String
  overview     String?
  posterPath   String?
  airDate      DateTime? @db.Date
  episodeCount Int       @default(0)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  series   Series         @relation(fields: [seriesId], references: [id], onDelete: Cascade)
  episodes Episode[]
  ratings  SeasonRating[]

  @@unique([seriesId, seasonNumber])
}

model Episode {
  id            String    @id @default(cuid())
  seasonId      String
  seriesId      String
  tmdbEpisodeId Int
  episodeNumber Int
  seasonNumber  Int
  name          String
  overview      String?
  airDate       DateTime? @db.Date
  runtime       Int?
  stillPath     String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  season  Season         @relation(fields: [seasonId], references: [id], onDelete: Cascade)
  series  Series         @relation(fields: [seriesId], references: [id], onDelete: Cascade)
  watches EpisodeWatch[]

  @@unique([seasonId, episodeNumber])
  @@index([seriesId, airDate])
}

model Genre {
  id        Int      @id // TMDB genre id
  name      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  series SeriesGenre[]
}

model SeriesGenre {
  seriesId String
  genreId  Int

  series Series @relation(fields: [seriesId], references: [id], onDelete: Cascade)
  genre  Genre  @relation(fields: [genreId], references: [id], onDelete: Cascade)

  @@id([seriesId, genreId])
  @@index([genreId])
}

// ───────────── User activity ─────────────

// One row per "watch event". At most one WATCHING row per (userId, seriesId):
// enforced by a partial unique index added in the init migration (see migration.sql).
model SeriesLog {
  id              String    @id @default(cuid())
  userId          String
  seriesId        String
  status          LogStatus
  startedAt       DateTime? @db.Date
  finishedAt      DateTime? @db.Date
  rating          Decimal?  @db.Decimal(2, 1) // 0.5–5.0, step 0.5 (validated in domain + CHECK)
  reviewText      String?
  containsSpoilers Boolean  @default(false)
  isRewatch       Boolean   @default(false)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  series Series @relation(fields: [seriesId], references: [id], onDelete: Restrict)

  @@index([userId, finishedAt(sort: Desc)])
  @@index([userId, createdAt(sort: Desc)])
  @@index([seriesId, rating])
}

model EpisodeWatch {
  id        String   @id @default(cuid())
  userId    String
  episodeId String
  seriesId  String
  watchedAt DateTime @default(now())
  rating    Decimal? @db.Decimal(2, 1)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  episode Episode @relation(fields: [episodeId], references: [id], onDelete: Cascade)
  series  Series  @relation(fields: [seriesId], references: [id], onDelete: Restrict)

  @@unique([userId, episodeId])
  @@index([userId, seriesId])
}

model SeasonRating {
  id         String   @id @default(cuid())
  userId     String
  seasonId   String
  rating     Decimal  @db.Decimal(2, 1)
  reviewText String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  season Season @relation(fields: [seasonId], references: [id], onDelete: Cascade)

  @@unique([userId, seasonId])
}

model WatchlistItem {
  id        String   @id @default(cuid())
  userId    String
  seriesId  String
  addedAt   DateTime @default(now())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  series Series @relation(fields: [seriesId], references: [id], onDelete: Restrict)

  @@unique([userId, seriesId])
  @@index([userId, addedAt(sort: Desc)])
}

model SeriesList {
  id          String   @id @default(cuid())
  userId      String
  title       String
  description String?
  isPublic    Boolean  @default(true)
  isRanked    Boolean  @default(false)
  slug        String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user  User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  items SeriesListItem[]

  @@unique([userId, slug])
  @@index([isPublic, createdAt(sort: Desc)])
}

model SeriesListItem {
  id        String   @id @default(cuid())
  listId    String
  seriesId  String
  position  Int
  note      String?
  addedAt   DateTime @default(now())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  list   SeriesList @relation(fields: [listId], references: [id], onDelete: Cascade)
  series Series     @relation(fields: [seriesId], references: [id], onDelete: Restrict)

  @@unique([listId, seriesId])
  // DEFERRABLE so reordering inside a transaction can swap positions; see migration.sql
  @@unique([listId, position])
}

model FavoriteSeries {
  id        String   @id @default(cuid())
  userId    String
  seriesId  String
  position  Int // 1–4 (CHECK in migration.sql)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  series Series @relation(fields: [seriesId], references: [id], onDelete: Restrict)

  @@unique([userId, position])
  @@unique([userId, seriesId])
}

// Rate limiting (DB-backed, simple fixed window; see docs/DECISIONS.md)
model RateLimit {
  key         String   @id
  count       Int
  windowStart DateTime
  blockedUntil DateTime?
}
